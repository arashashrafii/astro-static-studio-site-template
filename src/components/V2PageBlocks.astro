---
import V2RichText from './V2RichText.astro';
import V2CollectionView from './V2CollectionView.astro';
import V2ImageBlock from './V2ImageBlock.astro';
const {blocks,data}=Astro.props;
---
{blocks.map((block:any)=>block.type==='richText'?<V2RichText document={block.document}/>:block.type==='gallery'?<section class={`gallery v2-page-gallery v2-gallery-${block.layout??'grid'}`}>{block.images.map((image:any)=><figure><img src={image.src} alt={image.alt}/>{image.title&&<figcaption>{image.title}</figcaption>}</figure>)}</section>:block.type==='image'?<V2ImageBlock block={block}/>:<V2CollectionView block={block} collection={data.collections.find((item:any)=>item.id===block.collectionId)} items={data.items}/>) }
