---
const theme = { tokens: { background: '#f5f2eb', foreground: '#272b27' } };
const {data,title=data.site.name}=Astro.props;
const pages=data.pages.filter((page:any)=>page.published);
const collections=data.collections;
---
<!doctype html><html lang={data.site.language} dir={data.site.direction}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={data.site.tagline}/><title>{title===data.site.name?title:`${title} — ${data.site.name}`}</title><style is:global>
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;line-height:1.7;font-size:15px}a{color:inherit;text-decoration:none}a:hover{color:#895c42}header,footer{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:24px 6vw;border-bottom:1px solid #dedbd5}nav{display:flex;gap:26px;flex-wrap:wrap}.brand{font-family:Georgia,serif;font-size:25px;letter-spacing:.02em;direction:ltr}main{max-width:1360px;margin:auto;padding:68px 6vw}h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(40px,6vw,76px);font-weight:400;line-height:1.15;margin:24px 0}h2{font-family:Georgia,serif;font-weight:400;font-size:28px}.eyebrow{letter-spacing:3px;font:11px Arial;color:#9b4937}.hero{max-width:1000px;margin:25px 0 100px}.hero h1{max-width:980px}.hero p{max-width:580px;color:#666}.section-title{margin-bottom:30px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 42px}.card{display:block;border-top:1px solid #ccc;padding-top:16px}.card[hidden]{display:none}.card .placeholder{height:300px;background:linear-gradient(140deg,#ded4c6,#b9bdb2);display:grid;place-items:center;color:#514a42;font:italic 30px Georgia}.card img{width:100%;height:clamp(240px,35vw,490px);object-fit:cover;background:#ece9e3}.card h2{margin:14px 0 2px}.muted{color:#777;margin:8px 0}.category-list{font-size:11px;text-transform:uppercase;letter-spacing:1.4px;color:#9b4937;margin:8px 0}.category-filters{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 28px}.category-filters button{border:1px solid #dedbd5;background:transparent;border-radius:99px;padding:6px 16px;cursor:pointer;font:inherit;font-size:12px}.category-filters button.active,.category-filters button:hover{background:#343c34;color:#fff;border-color:#343c34}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:38px}figure{margin:0}figure img{width:100%;height:auto;display:block}figcaption{color:#666;font-size:12px;margin-top:8px}.prose{white-space:pre-wrap;max-width:880px;font-size:16px;line-height:2;margin-top:34px}.back-link{display:block;font-size:12px;color:#777;margin-bottom:38px}footer{margin-top:70px;border-top:1px solid #dedbd5;border-bottom:0;flex-wrap:wrap;font-size:13px}footer a{text-decoration:underline;text-underline-offset:3px}@media(max-width:650px){header{align-items:flex-start;flex-direction:column}nav{gap:18px}.grid,.gallery{grid-template-columns:1fr}main{padding-top:40px}.hero{margin-bottom:65px}.card img{height:320px}}
.rich-text-block{white-space:pre-wrap;line-height:1.9}.rich-text-block.rich-align-left{text-align:left}.rich-text-block.rich-align-center{text-align:center}.rich-text-block.rich-align-right{text-align:right}.rich-inline-image{max-width:min(100%,880px);height:auto;vertical-align:middle}.rich-size-small{font-size:.875em}.rich-size-large{font-size:1.25em}.rich-text-block h2{margin-top:1.5em}.rich-text-block h3,.rich-text-block h4{margin-top:1.25em}.v2-collection-view{margin:40px 0}.v2-collection-heading{display:flex;justify-content:space-between;align-items:center;gap:14px}.v2-collection-heading a{text-decoration:underline}.v2-collection-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.v2-collection-view.v2-view-list .v2-collection-items{grid-template-columns:1fr}.v2-item-card{display:block;border-top:1px solid #ccc;padding-top:14px}.v2-item-card>img{width:100%;height:clamp(220px,32vw,420px);object-fit:cover}.v2-item-card h3,.v2-item-card h2{margin:10px 0 4px}.v2-item-card p{color:#777}.v2-rich-block{white-space:pre-wrap;line-height:1.9}.v2-align-start{text-align:start}.v2-align-center{text-align:center}.v2-align-end{text-align:end}.v2-inline-image{max-width:min(100%,880px);height:auto;vertical-align:middle}.v2-size-small{font-size:.875em}.v2-size-normal{font-size:1em}.v2-size-large{font-size:1.25em}.v2-collection-view.v2-view-masonry .v2-collection-items{display:block;columns:2;column-gap:24px}.v2-collection-view.v2-view-masonry .v2-item-card{display:inline-block;width:100%;margin-bottom:24px;break-inside:avoid}@media(max-width:650px){.v2-collection-items{grid-template-columns:1fr}.v2-collection-view.v2-view-masonry .v2-collection-items{columns:1}}

.v2-collection-items .v2-item-card[hidden]{display:none}.v2-item-card time{display:block;margin-top:8px;color:#777;font-size:13px}.v2-collection-items.v2-view-list{grid-template-columns:1fr}.v2-collection-items.v2-view-list .v2-item-card{display:grid;grid-template-columns:minmax(140px,28%) 1fr;column-gap:20px;align-items:start}.v2-collection-items.v2-view-list .v2-item-card>img{grid-row:span 3;height:180px}.v2-collection-items.v2-kind-gallery .v2-item-card p{display:none}.v2-collection-items.v2-kind-gallery.v2-view-masonry{display:block;columns:3 220px;column-gap:20px}.v2-collection-items.v2-kind-gallery.v2-view-masonry .v2-item-card{display:inline-block;width:100%;margin:0 0 20px;break-inside:avoid}.v2-collection-items.v2-kind-gallery.v2-view-masonry .v2-item-card>img{height:auto}.v2-pagination{display:flex;align-items:center;justify-content:center;gap:24px;margin:28px 0}.v2-pagination a,.v2-show-more{border:1px solid #d7d5cf;padding:9px 18px;border-radius:5px;background:transparent;font:inherit;cursor:pointer}.v2-show-more{display:block;margin:28px auto}.v2-pagination a:hover,.v2-show-more:hover{background:#343c34;color:#fff}.gallery-photo-detail{max-width:1080px;margin:24px auto}.gallery-photo-detail figure img{max-height:75vh;object-fit:contain}.gallery-item-navigation{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:14px 0}.gallery-item-navigation a{text-decoration:underline}.item-cover{display:block;width:100%;max-height:70vh;object-fit:contain;margin:24px auto}.v2-collection-items.v2-view-masonry .v2-item-card h2{margin:8px 0 0}@media(max-width:700px){.v2-collection-items.v2-kind-gallery.v2-view-masonry{columns:2 140px}.v2-collection-items.v2-view-list .v2-item-card{grid-template-columns:1fr}.v2-collection-items.v2-view-list .v2-item-card>img{grid-row:auto;height:250px}.v2-pagination{gap:12px}.v2-pagination a{padding:8px 12px}}
.v2-page-gallery.v2-gallery-list{grid-template-columns:1fr}.v2-page-gallery.v2-gallery-list figure{display:grid;grid-template-columns:minmax(140px,28%) 1fr;align-items:center;gap:20px}.v2-page-gallery.v2-gallery-list figure img{grid-row:span 2}.v2-page-gallery.v2-gallery-masonry{display:block;columns:3 220px;column-gap:24px}.v2-page-gallery.v2-gallery-masonry figure{display:inline-block;width:100%;margin:0 0 24px;break-inside:avoid}.v2-page-gallery.v2-gallery-masonry img{height:auto}.v2-page-gallery figcaption{grid-column:2}@media(max-width:650px){.v2-page-gallery.v2-gallery-masonry{columns:2 140px}.v2-page-gallery.v2-gallery-list figure{grid-template-columns:minmax(90px,30%) 1fr;gap:12px}}

.v2-rich-block{display:flow-root}
.v2-inline-image-wrap{display:inline}
.v2-inline-image-wrap.v2-inline-image-wrap-start,.v2-inline-image-wrap.v2-inline-image-wrap-end{display:block;float:inline-start;width:min(42%,360px);margin-block:.35rem;margin-inline-end:1rem}
.v2-inline-image-wrap.v2-inline-image-wrap-end{float:inline-end;margin-inline-end:0;margin-inline-start:1rem}
.v2-inline-image-wrap.v2-inline-image-block-start,.v2-inline-image-wrap.v2-inline-image-block-center,.v2-inline-image-wrap.v2-inline-image-block-end{display:block;max-width:100%;margin-block:.75rem}
.v2-inline-image-wrap.v2-inline-image-block-start{margin-inline-start:0;margin-inline-end:auto}
.v2-inline-image-wrap.v2-inline-image-block-center{margin-inline-start:auto;margin-inline-end:auto}
.v2-inline-image-wrap.v2-inline-image-block-end{margin-inline-start:auto;margin-inline-end:0}
.v2-inline-image-wrap .v2-inline-image{display:block;width:100%;height:auto}
.v2-inline-image-wrap:not(.v2-inline-image-wrap-start):not(.v2-inline-image-wrap-end){width:max-content}
.v2-page-image{max-width:100%;margin:2rem 0}
.v2-page-image img{display:block;max-width:100%;height:auto}
.v2-image-align-start{margin-inline-start:0;margin-inline-end:auto}
.v2-image-align-center{margin-inline-start:auto;margin-inline-end:auto}
.v2-image-align-end{margin-inline-start:auto;margin-inline-end:0}
.v2-page-image.v2-image-size-small{width:min(42%,360px)}
.v2-page-image.v2-image-size-medium{width:min(68%,640px)}
.v2-page-image.v2-image-size-large{width:100%}
.v2-page-image figcaption{text-align:center;color:#777;font-size:.9rem;margin-top:.5rem}
@media(max-width:650px){.v2-inline-image-wrap.v2-inline-image-wrap-start,.v2-inline-image-wrap.v2-inline-image-wrap-end{width:44%}.v2-page-image.v2-image-size-small{width:55%}.v2-page-image.v2-image-size-medium{width:78%}}
</style></head><body style={`background:${theme.tokens.background};color:${theme.tokens.foreground}`}><header><a class="brand" href="/">{data.site.name}<span style="color:#9b4937">.</span></a><nav><a href="/">Home</a>{collections.map((collection:any)=><a href={`/${collection.slug}/`}>{collection.name}</a>)}{pages.map((e:any)=><a href={`/${e.slug}/`}>{e.title}</a>)}</nav></header><main><slot/></main><footer><span>{data.site.name} · {new Date().getFullYear()}</span>{data.site.phone&&<span>{data.site.phone}</span>}{data.site.email&&<a href={`mailto:${data.site.email}`}>{data.site.email}</a>}</footer></body></html>
