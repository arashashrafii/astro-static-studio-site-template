---
import Layout from '../layouts/Layout.astro';
import V2PageBlocks from '../components/V2PageBlocks.astro';
import V2CollectionView from '../components/V2CollectionView.astro';
import { content } from '../lib/content';

const data = content();
const homePage = data.pages.find(page => page.slug === 'home' && page.published);
const firstCollection = data.collections[0];
const homeCollectionBlock = firstCollection
  ? { type: 'collectionView', collectionId: firstCollection.id, view: 'grid', categoryIds: [], sort: 'manual', limit: 12 }
  : undefined;
---
<Layout data={data}>
  {homePage ? <>
    <section class="hero">
      <span class="eyebrow">{data.site.name}</span>
      <h1>{homePage.title}</h1>
      {homePage.description.source === 'manual' && <p>{homePage.description.value}</p>}
    </section>
    <V2PageBlocks blocks={homePage.blocks} data={data} />
  </> : <>
    <section class="hero">
      <span class="eyebrow">{data.site.name}</span>
      <h1>{data.site.tagline || data.site.name}</h1>
    </section>
    {firstCollection && homeCollectionBlock && <V2CollectionView block={homeCollectionBlock} collection={firstCollection} items={data.items} />}
  </>}
</Layout>
